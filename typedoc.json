{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/core/src/index.ts",
    "packages/schema-utils/src/index.ts",
    "packages/validator/src/index.ts",
    "packages/simulator/src/index.ts",
    "packages/simulator/src/1.6.ts",
    "packages/simulator/src/2.0.1.ts",
    "packages/simulator/src/browser/index.ts",
    "packages/simulator/src/node/index.ts",
    "packages/cli/src/index.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "out": "docs/api",
  "name": "OCPP Tools",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "validation": { "notExported": true, "invalidLink": true },
  "treatWarningsAsErrors": false
}
