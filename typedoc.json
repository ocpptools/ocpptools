{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["packages/core/src/index.ts"],
  "tsconfig": "packages/core/tsconfig.build.json",
  "out": "docs/api",
  "name": "OCPP Tools",
  "readme": "README.md",
