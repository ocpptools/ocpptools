{
  "name": "@ocpptools/builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Headless schema-driven OCPP-J payload and frame builder.",
  "license": "Apache-2.0",
  "author": "Rodolfo Carrillo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocpptools/ocpptools.git",
    "directory": "packages/builder"
  },
  "bugs": "https://github.com/ocpptools/ocpptools/issues",
  "homepage": "https://github.com/ocpptools/ocpptools",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b --clean tsconfig.build.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.json",
    "lint:package": "publint && attw --pack . --profile esm-only",
    "prepack": "node ../../scripts/sync-license.mjs copy",
    "size": "size-limit"
  },
  "dependencies": {
    "@ocpptools/core": "workspace:^",
    "@ocpptools/schema-utils": "workspace:^"
  },
  "devDependencies": {
    "@ocpptools/schemas": "workspace:*",
    "@ocpptools/tsconfig": "workspace:*",
    "@ocpptools/validator": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "path": "dist/*.js",
      "limit": "10 kB",
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    }
  ]
}
