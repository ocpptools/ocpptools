{
  "extends": "@ocpptools/tsconfig/library.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": {
      "@ocpptools/core": ["../core/src/index.ts"],
      "@ocpptools/simulator": ["./src/index.ts"],
      "@ocpptools/simulator/1.6": ["./src/1.6.ts"],
      "@ocpptools/simulator/2.0.1": ["./src/2.0.1.ts"],
      "@ocpptools/simulator/browser": ["./src/browser/index.ts"],
      "@ocpptools/simulator/node": ["./src/node/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist", "coverage"]
}
