{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": [
    "*.config.*",
    "eslint.config.mjs",
    "prettier.config.mjs",
    "vitest.config.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.ts"
  ]
}
