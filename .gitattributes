# Normalize text files in the repository to LF.
* text=auto

# Source, configuration, and documentation: LF in the working tree.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.astro text eol=lf
*.sh text eol=lf
*.cff text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.map text eol=lf
*.snap text eol=lf
*.lock text eol=lf

# Extensionless text files.
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.npmrc text eol=lf
.nvmrc text eol=lf
.reuse/dep5 text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
CODEOWNERS text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Lockfiles.
pnpm-lock.yaml text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.tar binary
*.mp4 binary
*.webm binary
*.mov binary
*.mp3 binary
*.wav binary
*.wasm binary

# OCA JSON Schemas: byte-for-byte copies of the originals. Never convert line
# endings or touch the bytes. The license (CC BY-ND 4.0) forbids sharing
# modified material. `pnpm lint:schemas` checks every file against a manifest.
packages/schemas/schemas/** -text
